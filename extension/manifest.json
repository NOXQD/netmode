{
  "manifest_version": 3,
  "name": "netmode: video accelerator",
  "version": "0.1.0",
  "description": "Sends AnimeLib video requests through the local netmode proxy.",
  "permissions": [
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://*.cdnlibs.org/*",
    "https://animelib.org/*",
    "https://*.animelib.org/*",
    "https://anilib.me/*",
    "https://*.anilib.me/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "netmode: video accelerator"
  }
}
