#!/usr/bin/env python3
"""netmode: network profiles (video / gaming / download) for Omarchy.

    netmode                     current mode and link status
    netmode set MODE            balanced | video | gaming | download
    netmode modes               list the modes
    netmode pulse               one line of JSON for the bar widget
    netmode bench               latency, jitter and throughput test
    netmode get URL [-n N]      segmented multi-connection download
    netmode auto [on|off]       auto-switch to video while AnimeLib is open
    netmode keepalive           keep the Wi-Fi link awake (100 tiny packets/s)
    netmode proxy               local accelerator for the AnimeLib video server
    netmode tune                fast DNS and the right network priority on the Wi-Fi profile
    netmode game                record a game session (ping, jitter, drops, Wi-Fi, CPU, GPU)
    netmode watch               the daemon behind `auto`
"""
import argparse
import collections
import concurrent.futures as cf
import http.client
import hmac
import http.server
import ipaddress
import json
import os
import random
import re
import secrets
import shutil
import socket
import statistics
import ssl
import struct
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

HELPER = "/usr/local/lib/netmode/netmode-root"
RUNTIME_STATE = "/run/netmode/state.json"
CONFIG_DIR = os.path.expanduser("~/.config/netmode")
CONFIG_FILE = CONFIG_DIR + "/config.json"
STATE_DIR = os.path.expanduser("~/.local/state/netmode")
BENCH_FILE = STATE_DIR + "/bench.json"

DEFAULT_CONFIG = {
    "auto_video": True,
    "patterns": [r"anime\s?lib", r"anilib"],
    "browsers": ["chromium", "chrome", "brave", "vivaldi", "firefox", "zen", "opera"],
    "dns_servers": ["1.0.0.1", "1.1.1.1"],
    "wifi_priority": 100,
    "wifi_deprioritize": [r"^FTTH-"],        # SSIDs that should never win against the main network
    "auto_game": True,
    "game_processes": ["sober"],
    "proxy_port": 18765,
    "proxy_ahead_mb": 160,
    "proxy_hosts": [],                       # empty: any public host
    "proxy_exclude": [r"(^|\.)(youtube\.com|googlevideo\.com|netflix\.com|nflxvideo\.net|twitch\.tv|ttvnw\.net|spotify\.com|scdn\.co)$"],
    "proxy_referers": [[r"(^|\.)cdnlibs\.org$", "https://animelib.org/"]],
    "proxy_bypass_hours": 6,
}


# ---------------------------------------------------------------- helpers

def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)


def config():
    cfg = dict(DEFAULT_CONFIG)
    cfg.update(load_json(CONFIG_FILE, {}))
    return cfg


def out(cmd, timeout=5):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def helper_json(*args):
    if not os.path.exists(HELPER):
        return None
    try:
        return json.loads(out([HELPER, *args]))
    except ValueError:
        return None


def modes():
    return helper_json("list") or []


def current_mode():
    state = load_json(RUNTIME_STATE, None)
    if state and state.get("mode"):
        return state["mode"]
    return "balanced"


def notify(title, body="", glyph=""):
    if shutil.which("omarchy-notification-send"):
        cmd = ["omarchy-notification-send", "--app-name", "netmode"]
        if glyph:
            cmd += ["-g", glyph]
        subprocess.run(cmd + [title, body], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def escalate(argv):
    """Run the helper as root: directly, via a sudoers grant, or via polkit."""
    if os.geteuid() == 0:
        return subprocess.run(argv).returncode
    if shutil.which("sudo"):
        r = subprocess.run(["sudo", "-n", *argv], capture_output=True, text=True)
        if r.returncode == 0:
            return 0
    if shutil.which("pkexec"):
        return subprocess.run(["pkexec", *argv]).returncode
    return 1


def set_mode(mode, quiet=False):
    known = {m["id"]: m for m in modes()}
    if not known:
        print("netmode: helper is not installed, run ./install.sh", file=sys.stderr)
        return 1
    if mode not in known:
        print("netmode: unknown mode %r (%s)" % (mode, ", ".join(known)), file=sys.stderr)
        return 2
    rc = escalate([HELPER, "apply", mode])
    if rc != 0:
        print("netmode: could not apply %s (exit %d)" % (mode, rc), file=sys.stderr)
        return rc
    if not quiet:
        m = known[mode]
        notify("Сеть: " + m["name"], m["blurb"], m["icon"])
    return 0


# ---------------------------------------------------------------- link info

def wifi_iface():
    base = "/sys/class/net"
    for name in sorted(os.listdir(base)):
        if os.path.isdir("%s/%s/wireless" % (base, name)):
            return name
    return None


def wifi_standard(bitrate_line):
    """("Wi-Fi 6", 160) from an `iw link` bitrate line, e.g. '... VHT-MCS 9 80MHz ...'."""
    std = ("Wi-Fi 7" if "EHT" in bitrate_line else "Wi-Fi 6" if "HE-MCS" in bitrate_line
           else "Wi-Fi 5" if "VHT" in bitrate_line else "Wi-Fi 4" if "MCS" in bitrate_line else None)
    m = re.search(r"(\d+)MHz", bitrate_line)
    return std, int(m.group(1)) if m else None


def wifi_info():
    iface = wifi_iface()
    if not iface:
        return None
    text = out(["iw", "dev", iface, "link"])
    if "Not connected" in text or not text.strip():
        return {"iface": iface, "connected": False}
    info = {"iface": iface, "connected": True}
    for key, rx in (("ssid", r"SSID: (.+)"), ("signal", r"signal: (-?\d+)"),
                    ("freq", r"freq: (\d+)"), ("rx", r"rx bitrate: ([\d.]+)"),
                    ("tx", r"tx bitrate: ([\d.]+)")):
        m = re.search(rx, text)
        if m:
            v = m.group(1)
            info[key] = v if key == "ssid" else float(v)
    m = re.search(r"tx bitrate: (.+)", text)
    if m:
        info["standard"], info["width"] = wifi_standard(m.group(1))
    return info


def default_gateway():
    m = re.search(r"default via (\S+)", out(["ip", "route", "show", "default"]))
    return m.group(1) if m else None


def dns_servers():
    m = re.search(r"Current DNS Server: (\S+)", out(["resolvectl", "status"]))
    return m.group(1) if m else None


def ping(host, count=4, interval=0.2):
    """Return {avg,min,max,jitter,loss} in ms for host, or None."""
    if not host:
        return None
    text = out(["ping", "-c", str(count), "-i", str(interval), "-W", "1", "-q", host],
               timeout=count * (interval + 1) + 3)
    m = re.search(r"= ([\d.]+)/([\d.]+)/([\d.]+)/([\d.]+) ms", text)
    loss = re.search(r"([\d.]+)% packet loss", text)
    if not m:
        return {"loss": 100.0} if loss else None
    lo, avg, hi, mdev = (float(x) for x in m.groups())
    return {"min": lo, "avg": avg, "max": hi, "jitter": mdev,
            "loss": float(loss.group(1)) if loss else 0.0}


def snapshot(deep=False):
    gw = default_gateway()
    count, interval = (20, 0.1) if deep else (3, 0.2)
    with cf.ThreadPoolExecutor(2) as pool:
        f_gw = pool.submit(ping, gw, count, interval)
        f_net = pool.submit(ping, "1.1.1.1", count, interval)
        gw_ping, net_ping = f_gw.result(), f_net.result()
    return {
        "mode": current_mode(),
        "cc": open("/proc/sys/net/ipv4/tcp_congestion_control").read().strip(),
        "dns": dns_servers(),
        "wifi": wifi_info(),
        "gateway": gw_ping,
        "internet": net_ping,
        "auto": config()["auto_video"],
        "proxy": proxy_stats(),
        "bench": load_json(BENCH_FILE, None),
    }


# ---------------------------------------------------------------- bench

def dns_probe(server, name, timeout=2.0):
    tid = random.randint(0, 65535)
    q = b"".join(bytes([len(p)]) + p.encode() for p in name.split(".")) + b"\0"
    pkt = struct.pack(">HHHHHH", tid, 0x0100, 1, 0, 0, 0) + q + struct.pack(">HH", 1, 1)
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    t0 = time.perf_counter()
    try:
        s.sendto(pkt, (server, 53))
        s.recvfrom(1500)
        return (time.perf_counter() - t0) * 1000
    except OSError:
        return None
    finally:
        s.close()


def bench_dns():
    """Cached vs. uncached lookup time through the system stub resolver."""
    stub = "127.0.0.53"
    cached = [dns_probe(stub, "cloudflare.com") for _ in range(6)][1:]
    cached = [x for x in cached if x is not None]
    miss = [dns_probe(stub, "n%06d.cloudflare.com" % random.randint(0, 999999)) for _ in range(5)]
    miss = [x for x in miss if x is not None]
    return {
        "cached_ms": round(min(cached), 1) if cached else None,
        "miss_ms": round(statistics.median(miss), 1) if miss else None,
    }


def stream_bytes(deadline, counter, lock):
    """Pull from Cloudflare's speed endpoint until the deadline."""
    try:
        conn = http.client.HTTPSConnection("speed.cloudflare.com", timeout=8)
        while time.monotonic() < deadline:
            conn.request("GET", "/__down?bytes=50000000", headers={"User-Agent": "netmode"})
            resp = conn.getresponse()
            if resp.status != 200:
                return
            while time.monotonic() < deadline:
                chunk = resp.read(262144)
                if not chunk:
                    break
                with lock:
                    counter[0] += len(chunk)
            if time.monotonic() >= deadline:
                conn.close()
                return
    except OSError:
        return


def throughput(streams, seconds=4.0):
    counter, lock = [0], threading.Lock()
    t0 = time.monotonic()
    deadline = t0 + seconds
    threads = [threading.Thread(target=stream_bytes, args=(deadline, counter, lock))
               for _ in range(streams)]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    elapsed = max(time.monotonic() - t0, 0.001)
    return round(counter[0] * 8 / elapsed / 1e6, 1) if counter[0] else None     # None: the test server refused


def bench(progress=None):
    step = progress or (lambda s: None)
    result = {"when": int(time.time()), "mode": current_mode()}
    step("dns")
    result["dns"] = bench_dns()
    step("latency")
    result["gateway"] = ping(default_gateway(), 30, 0.1)
    result["internet"] = ping("1.1.1.1", 30, 0.1)
    step("down1")
    result["down_1"] = throughput(1)
    step("down4")
    with cf.ThreadPoolExecutor(1) as pool:
        loaded = pool.submit(ping, "1.1.1.1", 25, 0.15)
        result["down_4"] = throughput(4, 4.5)
        result["loaded"] = loaded.result()
    save_json(BENCH_FILE, result)
    return result


def fmt_ping(p):
    if not p or "avg" not in p:
        return "—"
    return "%.1f мс (джиттер %.1f, макс %.0f, потери %g%%)" % (p["avg"], p["jitter"], p["max"], p["loss"])


def print_bench(r):
    print("режим        %s" % r["mode"])
    print("DNS          кэш %s мс, без кэша %s мс%s" % (r["dns"]["cached_ms"], r["dns"]["miss_ms"],
          "   (медленно, поможет netmode tune)" if (r["dns"]["miss_ms"] or 0) > 60 else ""))
    print("роутер       %s" % fmt_ping(r["gateway"]))
    print("интернет     %s" % fmt_ping(r["internet"]))
    print("под нагрузкой %s" % fmt_ping(r["loaded"]))
    if r["down_1"] is None and r["down_4"] is None:
        print("скачивание   нет данных: сервер теста не отдал файл (лимит запросов), повторите позже")
    else:
        print("скачивание   1 поток %s Мбит/с, 4 потока %s Мбит/с" % (r["down_1"], r["down_4"]))


# ---------------------------------------------------------------- downloader

class Progress:
    def __init__(self, total):
        self.total, self.done, self.lock = total, 0, threading.Lock()
        self.t0 = time.monotonic()

    def add(self, n):
        with self.lock:
            self.done += n

    def line(self):
        el = max(time.monotonic() - self.t0, 0.001)
        rate = self.done / el
        pct = " %3d%%" % (100 * self.done // self.total) if self.total else ""
        return "\r%7.1f МБ  %6.1f МБ/с%s " % (self.done / 1e6, rate / 1e6, pct)


def probe(url):
    """Return (final_url, size or None, ranges_ok)."""
    req = urllib.request.Request(url, headers={"Range": "bytes=0-0", "User-Agent": "netmode"})
    with urllib.request.urlopen(req, timeout=15) as r:
        final = r.geturl()
        cr = r.headers.get("Content-Range")
        if r.status == 206 and cr and "/" in cr and cr.rsplit("/", 1)[1].isdigit():
            return final, int(cr.rsplit("/", 1)[1]), True
        length = r.headers.get("Content-Length")
        return final, int(length) if length and length.isdigit() else None, False


def fetch_range(parts, start, end, fd, prog, tries=6):
    for attempt in range(tries):
        conn, pos = None, start
        try:
            cls = http.client.HTTPSConnection if parts.scheme == "https" else http.client.HTTPConnection
            conn = cls(parts.netloc, timeout=20)
            path = parts.path or "/"
            if parts.query:
                path += "?" + parts.query
            conn.request("GET", path, headers={"Range": "bytes=%d-%d" % (start, end),
                                               "User-Agent": "netmode"})
            r = conn.getresponse()
            if r.status != 206:
                raise OSError("server answered %d" % r.status)
            while pos <= end:
                chunk = r.read(min(262144, end - pos + 1))
                if not chunk:
                    raise OSError("short read")
                os.pwrite(fd, chunk, pos)
                pos += len(chunk)
                prog.add(len(chunk))
            return
        except OSError:
            prog.add(-(pos - start))
            time.sleep(min(2 ** attempt * 0.25, 4))
        finally:
            if conn:
                conn.close()
    raise OSError("range %d-%d failed" % (start, end))


def cmd_get(args):
    url = args.url
    final, size, ranges = probe(url)
    name = args.output or os.path.basename(urllib.parse.urlsplit(final).path) or "download"
    parts = urllib.parse.urlsplit(final)
    n = max(1, args.connections)
    if not (size and ranges):
        print("сервер не поддерживает докачку по частям, качаю одним потоком", file=sys.stderr)
        n = 1
    part = name + ".part"
    fd = os.open(part, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    prog = Progress(size)
    stop = threading.Event()

    def ticker():
        while not stop.wait(0.25):
            sys.stderr.write(prog.line())
            sys.stderr.flush()

    threading.Thread(target=ticker, daemon=True).start()
    try:
        if size and ranges:
            os.ftruncate(fd, size)
            chunk = max(1 << 20, size // (n * 6))
            spans = [(s, min(s + chunk, size) - 1) for s in range(0, size, chunk)]
            with cf.ThreadPoolExecutor(n) as pool:
                for fut in [pool.submit(fetch_range, parts, a, b, fd, prog) for a, b in spans]:
                    fut.result()
        else:
            with urllib.request.urlopen(urllib.request.Request(final, headers={"User-Agent": "netmode"})) as r:
                while True:
                    buf = r.read(262144)
                    if not buf:
                        break
                    os.write(fd, buf)
                    prog.add(len(buf))
    finally:
        stop.set()
        os.close(fd)
    os.replace(part, name)
    sys.stderr.write(prog.line() + "\n")
    print(name)
    return 0


# ---------------------------------------------------------------- keepalive

def cmd_keepalive(args):
    """Send a tiny UDP packet to the router hz times a second.

    An idle Wi-Fi link here wakes up with 100-200 ms latency spikes. A steady
    trickle of packets keeps the radio and the router's queue awake: measured
    on this machine, 0 spikes over 20 ms in 150 pings at 100 Hz against 7-17
    without. It costs ~6 KB/s and a little power, so it is only on in the
    performance modes.
    """
    period = 1.0 / args.hz
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    gateway, checked = None, 0.0
    nxt = time.monotonic()
    while True:
        now = time.monotonic()
        if now - checked > 5:
            gateway, checked = default_gateway(), now
        if not gateway:
            time.sleep(2)
            checked = 0.0
            nxt = time.monotonic()
            continue
        try:
            sock.sendto(b"k", (gateway, 9))
        except OSError:
            time.sleep(1)
        nxt += period
        delay = nxt - time.monotonic()
        if delay > 0:
            time.sleep(delay)
        elif delay < -1:
            nxt = time.monotonic()


# ---------------------------------------------------------------- video proxy
#
# The AnimeLib video servers give every TCP connection a fast start (tens of
# Mbit/s for ~10 s) and then cut it to 3-6 Mbit/s. A browser plays a file over
# one long connection, so 4K runs out of buffer every few seconds. This proxy
# answers the player on localhost and fetches the bytes from the server in short
# ranges over fresh connections, six at a time: ~120 Mbit/s sustained in tests.

SPAN_FIRST = 1 << 20
SPAN_MAX = 8 << 20
FETCHERS = 8
AHEAD = 160 << 20             # how far past the player's position the proxy keeps fetching
CACHE_MAX = 320 << 20


def spans(start, end):
    """Byte ranges to fetch for start..end: small first, so playback begins fast."""
    size = SPAN_FIRST
    while start <= end:
        stop = min(start + size - 1, end)
        yield start, stop
        start = stop + 1
        size = min(size * 2, SPAN_MAX)


def parse_range(header, total):
    """Return (start, end) inclusive for a single-range header, or None if unsatisfiable."""
    if not header:
        return 0, total - 1
    m = re.fullmatch(r"bytes=(\d*)-(\d*)", header.strip())
    if not m or (not m.group(1) and not m.group(2)):
        return 0, total - 1
    if not m.group(1):                                   # suffix: last N bytes
        n = int(m.group(2))
        return max(total - n, 0), total - 1
    start = int(m.group(1))
    end = min(int(m.group(2)), total - 1) if m.group(2) else total - 1
    return (start, end) if start <= end and start < total else None


def proxy_token():
    """The shared secret between the proxy and the extension; created on first use."""
    path = CONFIG_DIR + "/proxy-token"
    try:
        with open(path) as f:
            tok = f.read().strip()
        if re.fullmatch(r"[0-9a-f]{32}", tok):
            return tok
    except OSError:
        pass
    tok = secrets.token_hex(16)
    os.makedirs(CONFIG_DIR, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(tok + "\n")
    return tok


_public = {}


def public_host(host):
    """True when every address the name resolves to is a public one."""
    hit = _public.get(host)
    if hit and time.time() - hit[0] < 120:
        return hit[1]
    try:
        addrs = {i[4][0] for i in socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)}
        ok = bool(addrs) and all(ipaddress.ip_address(a.split("%")[0]).is_global for a in addrs)
    except (OSError, ValueError):
        ok = False
    _public[host] = (time.time(), ok)
    return ok


class SlowConnection(Exception):
    pass


class CancelledError(Exception):
    pass


class SpanCache:
    """Fetched byte ranges of the videos in memory, least recently used out first."""

    def __init__(self, limit):
        self.limit = limit
        self.lock = threading.Lock()
        self.files = {}
        self.lru = collections.OrderedDict()
        self.size = 0

    def add(self, key, start, data):
        with self.lock:
            segs = self.files.setdefault(key, {})
            old = segs.get(start)
            if old is not None:
                self.size -= len(old)
            segs[start] = data
            self.size += len(data)
            self.lru[(key, start)] = True
            self.lru.move_to_end((key, start))
            while self.size > self.limit and self.lru:
                (k, st), _ = self.lru.popitem(last=False)
                self.size -= len(self.files[k].pop(st))

    def read(self, key, pos):
        """The cached bytes from pos to the end of the segment holding it, or None."""
        with self.lock:
            for st, data in self.files.get(key, {}).items():
                if st <= pos < st + len(data):
                    self.lru.move_to_end((key, st))
                    return memoryview(data)[pos - st:]
        return None


class Origin:
    """Short-lived connections to the video hosts, with a small size cache."""

    def __init__(self, scheme="https", ahead=AHEAD):
        self.scheme = scheme
        self.ahead = ahead
        self.cache = SpanCache(ahead * 2)
        self.pool = cf.ThreadPoolExecutor(max_workers=FETCHERS)
        self.urgent = cf.ThreadPoolExecutor(max_workers=FETCHERS)
        self.meta = {}
        self.lock = threading.Lock()
        self.served = 0
        self.started = time.time()
        self.bypass = {}

    def connect(self, host):
        if self.scheme == "https":
            return http.client.HTTPSConnection(host, timeout=15, context=ssl.create_default_context())
        return http.client.HTTPConnection(host, timeout=15)

    def get(self, host, path, headers, byte_range=None):
        conn = self.connect(host)
        hdr = dict(headers, Connection="close")
        if byte_range:
            hdr["Range"] = "bytes=%d-%d" % byte_range
        conn.request("GET", path, headers=hdr)
        return conn, conn.getresponse()

    def mark_bypass(self, host, hours):
        with self.lock:
            self.bypass[host] = time.time() + hours * 3600

    def bypassed(self):
        now = time.time()
        with self.lock:
            self.bypass = {h: t for h, t in self.bypass.items() if t > now}
            return sorted(self.bypass)

    def probe(self, host, path, headers, first=None):
        """(info, passthrough). info has size and validators and is cached for ten minutes.

        When the first range the player wants is known, it is requested here and
        kept, so the size costs no extra round trip. If the server does not
        answer with a range, the open response is returned as `passthrough`
        for the caller to relay untouched.
        """
        key = (host, path)
        with self.lock:
            hit = self.meta.get(key)
        if hit and time.time() - hit[0] < 600:
            return hit[1], None
        conn, r = self.get(host, path, headers, first or (0, 0))
        info = {"status": r.status, "type": r.getheader("Content-Type", "video/mp4"),
                "etag": r.getheader("ETag"), "modified": r.getheader("Last-Modified"), "size": None}
        m = re.fullmatch(r"bytes (\d+)-(\d+)/(\d+)", r.getheader("Content-Range", ""))
        if r.status != 206 or not m:
            return info, (conn, r)
        try:
            data = r.read()
        finally:
            conn.close()
        info["size"] = int(m.group(3))
        if first and int(m.group(1)) == first[0] and len(data) == int(m.group(2)) - first[0] + 1:
            self.cache.add(key, first[0], data)
        with self.lock:
            self.meta[key] = (time.time(), info)
        return info, None

    def fetch_span(self, host, path, headers, a, b, cancel=None, tries=6):
        """One range over its own connection.

        A fresh connection is sometimes throttled from the start. A span that is
        far behind schedule is dropped and fetched again on a new connection;
        the last try is never dropped.
        """
        size = b - a + 1
        for attempt in range(tries):
            conn = None
            last = attempt == tries - 1
            try:
                t0 = time.monotonic()
                conn, r = self.get(host, path, headers, (a, b))
                if r.status != 206:
                    raise OSError("span %d-%d: status %d" % (a, b, r.status))
                parts, got = [], 0
                while got < size:
                    if cancel is not None and cancel.is_set():
                        raise CancelledError()
                    chunk = r.read(min(65536, size - got))
                    if not chunk:
                        raise OSError("span %d-%d: short read" % (a, b))
                    parts.append(chunk)
                    got += len(chunk)
                    elapsed = time.monotonic() - t0
                    if not last and elapsed > 2.5 and got < size * (elapsed - 1.0) / 6:
                        raise SlowConnection()
                return b"".join(parts)
            except (SlowConnection, OSError, http.client.HTTPException):
                if last or (cancel is not None and cancel.is_set()):
                    raise
            finally:
                if conn:
                    conn.close()

    def fetch_into_cache(self, key, headers, a, b, cancel):
        try:
            data = self.fetch_span(key[0], key[1], headers, a, b, cancel)
        except CancelledError:
            return
        self.cache.add(key, a, data)

    def stream(self, host, path, headers, start, end, write):
        """Write start..end to `write`.

        Spans are fetched up to `ahead` bytes past the position the player has
        read, so a slow stretch or a burst of bitrate is absorbed by memory
        instead of reaching the player. Spans still queued when the player goes
        away are dropped and the running ones are stopped.
        """
        key = (host, path)
        pos, nxt, size = start, start, SPAN_FIRST
        pending = []
        cancel = threading.Event()

        def submit(a, b):
            # The spans the player needs first skip the line behind earlier prefetching.
            pool = self.urgent if a - start < 3 * SPAN_MAX else self.pool
            fut = pool.submit(self.fetch_into_cache, key, headers, a, b, cancel)
            pending.append((a, b, fut))

        try:
            while pos <= end:
                # Deep prefetch only once the player has really started reading,
                # so a page that merely preloads many videos costs little.
                ahead = min(self.ahead, max(16 << 20, 4 * (pos - start)))
                while nxt <= end and nxt - pos < ahead:
                    hit = self.cache.read(key, nxt)
                    if hit is not None:
                        nxt += len(hit)
                        continue
                    stop = min(nxt + size - 1, end)
                    size = min(size * 2, SPAN_MAX)
                    submit(nxt, stop)
                    nxt = stop + 1
                chunk = self.cache.read(key, pos)
                if chunk is None:
                    fut = next((f for a, b, f in pending if a <= pos <= b), None)
                    if fut is None:                       # evicted before it was read
                        submit(pos, min(pos + SPAN_MAX - 1, end))
                        fut = pending[-1][2]
                    fut.result()
                    continue
                n = min(len(chunk), end - pos + 1)
                write(chunk[:n])
                pos += n
                with self.lock:
                    self.served += n
                pending = [p for p in pending if p[1] >= pos]
        finally:
            cancel.set()
            for _, _, fut in pending:
                fut.cancel()


class ProxyHandler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    origin = None
    token = ""
    hosts = []
    exclude = []
    referers = []
    bypass_hours = 6
    check_host = staticmethod(public_host)
    verbose = False

    def log_message(self, fmt, *args):
        if self.verbose:
            sys.stderr.write("%s\n" % (fmt % args))

    def cors(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.send_header("Access-Control-Expose-Headers", "Content-Range, Content-Length, Accept-Ranges")

    def reply(self, code, body=b"", ctype="text/plain"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.cors()
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def do_OPTIONS(self):
        self.reply(204)

    def do_HEAD(self):
        self.do_GET()

    def refuse(self, host, why):
        """Say no, and put the host on the list the extension stops redirecting."""
        self.origin.mark_bypass(host, self.bypass_hours)
        self.reply(403, why.encode())

    def referer_for(self, host):
        for pattern, referer in self.referers:
            if re.search(pattern, host):
                return referer
        return None

    def relay(self, conn, r):
        """Pass an answer we cannot accelerate through unchanged."""
        try:
            self.send_response(r.status)
            for name in ("Content-Type", "Content-Length", "Content-Range", "Accept-Ranges",
                         "ETag", "Last-Modified", "Location"):
                value = r.getheader(name)
                if value:
                    self.send_header(name, value)
            if r.getheader("Content-Length") is None:
                self.send_header("Connection", "close")
                self.close_connection = True
            self.cors()
            self.end_headers()
            if self.command != "HEAD":
                while True:
                    chunk = r.read(65536)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
        finally:
            conn.close()

    def do_GET(self):
        if self.path == "/ping":
            return self.reply(200, b"netmode-proxy")
        if self.path == "/stats":
            o = self.origin
            return self.reply(200, json.dumps({"served": o.served, "cached": o.cache.size,
                                               "since": int(o.started)}).encode(), "application/json")
        if self.path == "/bypass":
            return self.reply(200, json.dumps(self.origin.bypassed()).encode(), "application/json")
        m = re.match(r"^/([0-9a-f]{32})/([A-Za-z0-9.-]{1,253})(/.*)$", self.path)
        if not m or not hmac.compare_digest(m.group(1), self.token):
            return self.reply(403, b"forbidden")
        host, path = m.group(2), m.group(3)
        if self.hosts and not any(re.search(p, host) for p in self.hosts):
            return self.refuse(host, "host not allowed")
        if any(re.search(p, host) for p in self.exclude):
            return self.refuse(host, "host excluded")
        if not self.check_host(host):
            return self.refuse(host, "not a public host")
        fwd = {"User-Agent": self.headers.get("User-Agent", "Mozilla/5.0"),
               "Accept": "*/*", "Accept-Encoding": "identity"}
        referer = self.referer_for(host)
        if referer:
            fwd["Referer"] = referer
        try:
            m = re.match(r"bytes=(\d+)-", self.headers.get("Range") or "")
            first = (int(m.group(1)), int(m.group(1)) + SPAN_FIRST - 1) if m else None
            info, passthrough = self.origin.probe(host, path, fwd, first)
            if passthrough:
                conn, r = passthrough
                if r.status >= 400 or r.status == 200:      # no ranges, or refused: stay out next time
                    self.origin.mark_bypass(host, self.bypass_hours)
                return self.relay(conn, r)
            size = info["size"]
            rng = parse_range(self.headers.get("Range"), size)
            if rng is None:
                self.send_response(416)
                self.send_header("Content-Range", "bytes */%d" % size)
                self.send_header("Content-Length", "0")
                self.cors()
                self.end_headers()
                return
            start, end = rng
            partial = bool(self.headers.get("Range"))
            self.send_response(206 if partial else 200)
            self.send_header("Content-Type", info["type"])
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Content-Length", str(end - start + 1))
            if partial:
                self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end, size))
            for k, v in (("ETag", info["etag"]), ("Last-Modified", info["modified"])):
                if v:
                    self.send_header(k, v)
            self.cors()
            self.end_headers()
            if self.command != "HEAD":
                self.origin.stream(host, path, fwd, start, end, self.wfile.write)
        except (BrokenPipeError, ConnectionResetError):
            self.close_connection = True                   # the player stopped reading
        except (OSError, ssl.SSLError, http.client.HTTPException) as e:
            sys.stderr.write("proxy: %s%s: %s\n" % (host, path[:60], e))
            self.origin.mark_bypass(host, 0.25)            # unreachable or broken: let the browser try itself
            self.close_connection = True


def make_proxy(port, token, scheme="https", verbose=False, origin=None, ahead=AHEAD, hosts=(),
               exclude=(), referers=(), bypass_hours=6, check_host=None):
    attrs = {"origin": origin or Origin(scheme, ahead), "token": token, "hosts": list(hosts),
             "exclude": list(exclude), "referers": list(referers), "bypass_hours": bypass_hours,
             "verbose": verbose}
    if check_host:
        attrs["check_host"] = staticmethod(check_host)
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), type("Handler", (ProxyHandler,), attrs))
    server.daemon_threads = True
    return server


def cmd_proxy(args):
    cfg = config()
    server = make_proxy(args.port or cfg["proxy_port"], proxy_token(), verbose=args.verbose,
                        ahead=int(cfg["proxy_ahead_mb"]) << 20, hosts=cfg["proxy_hosts"],
                        exclude=cfg["proxy_exclude"], referers=cfg["proxy_referers"],
                        bypass_hours=cfg["proxy_bypass_hours"])
    print("netmode proxy on 127.0.0.1:%d" % server.server_address[1], file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def cmd_token(_args):
    print(proxy_token())
    return 0


def proxy_stats():
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/stats" % config()["proxy_port"], timeout=0.4) as r:
            return json.loads(r.read())
    except (OSError, ValueError):
        return None


# ---------------------------------------------------------------- wifi profile tuning

def nm_active_wifi():
    """(profile name, ssid) of the Wi-Fi connection that is up, or None."""
    for line in out(["nmcli", "-t", "-f", "NAME,TYPE,DEVICE", "connection", "show", "--active"]).splitlines():
        parts = line.rsplit(":", 2)
        if len(parts) == 3 and parts[1] == "802-11-wireless":
            return parts[0].replace("\\:", ":")
    return None


def nm_wifi_profiles():
    names = []
    for line in out(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"]).splitlines():
        name, _, kind = line.rpartition(":")
        if kind == "802-11-wireless":
            names.append(name.replace("\\:", ":"))
    return names


def tune_commands(active, profiles, cfg, current, on_5ghz):
    """nmcli calls that bring the profile to the wanted state; `current` maps profile -> setting dict."""
    cmds = []
    want = {"ipv4.dns": ",".join(cfg["dns_servers"]), "ipv4.ignore-auto-dns": "yes", "ipv4.dns-priority": "-50",
            "connection.autoconnect-priority": str(cfg["wifi_priority"])}
    if on_5ghz:
        want["802-11-wireless.band"] = "a"
    have = current.get(active, {})
    args = []
    for key, value in want.items():
        if have.get(key, "").replace(",", " ").split() != value.replace(",", " ").split():
            args += [key, value.replace(",", " ") if key == "ipv4.dns" else value]
    if args:
        cmds.append(["nmcli", "connection", "modify", active] + args)
    for name in profiles:
        if name != active and any(re.search(p, name) for p in cfg["wifi_deprioritize"]):
            if current.get(name, {}).get("connection.autoconnect-priority") != "-100":
                cmds.append(["nmcli", "connection", "modify", name, "connection.autoconnect-priority", "-100"])
    return cmds


def cmd_tune(args):
    active = nm_active_wifi()
    if not active:
        print("нет активного Wi-Fi", file=sys.stderr)
        return 1
    cfg = config()
    profiles = nm_wifi_profiles()
    keys = ["ipv4.dns", "ipv4.ignore-auto-dns", "ipv4.dns-priority", "connection.autoconnect-priority", "802-11-wireless.band"]
    current = {}
    for name in profiles:
        vals = {}
        for k in keys:
            vals[k] = out(["nmcli", "-g", k, "connection", "show", name]).strip().replace(",", " ") if k == "ipv4.dns" \
                else out(["nmcli", "-g", k, "connection", "show", name]).strip()
        current[name] = vals
    info = wifi_info() or {}
    cmds = tune_commands(active, profiles, cfg, current, (info.get("freq") or 0) > 5000)
    if not cmds:
        print("профиль %s уже настроен" % active)
        return 0
    for c in cmds:
        print(" ".join(c[2:]) if args.dry_run else "nmcli " + " ".join(c[1:]))
        if not args.dry_run and subprocess.run(c).returncode != 0:
            print("не удалось применить: нужны права на настройку сети", file=sys.stderr)
            return 1
    if not args.dry_run:
        subprocess.run(["nmcli", "device", "reapply", info.get("iface", "wlo1")], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)   # the band applies at the next connect
        print("готово: DNS %s, профиль %s в приоритете" % (", ".join(cfg["dns_servers"]), active))
    return 0


# ---------------------------------------------------------------- game sessions

def game_pids(cfg):
    names = set(cfg["game_processes"])
    pids = []
    for d in os.listdir("/proc"):
        if d.isdigit():
            try:
                with open("/proc/%s/comm" % d) as f:
                    if f.read().strip() in names:
                        pids.append(int(d))
            except OSError:
                pass
    return pids


def game_running(cfg):
    return bool(game_pids(cfg))


def thread_ticks(pid):
    """{tid: utime+stime} for every thread of the process."""
    out = {}
    try:
        for tid in os.listdir("/proc/%d/task" % pid):
            with open("/proc/%d/task/%s/stat" % (pid, tid)) as f:
                raw = f.read()
            fields = raw[raw.rindex(")") + 2:].split()
            out[tid] = int(fields[11]) + int(fields[12])
    except (OSError, ValueError):
        pass
    return out


def udp_sockets(pids):
    """UDP sockets of the game: (peer address, packets dropped by the kernel)."""
    text = out(["ss", "-uamnp"], timeout=3)
    socks, cur = [], None
    for line in text.splitlines():
        if "pid=" in line:
            m = re.search(r"pid=(\d+)", line)
            cols = line.split()
            cur = (cols[4] if len(cols) > 4 else "", int(m.group(1))) if m and int(m.group(1)) in pids else None
        elif cur and "skmem" in line:
            d = re.search(r",d(\d+)\)", line)
            socks.append((cur[0], int(d.group(1)) if d else 0))
            cur = None
    return socks


def gpu_sample():
    text = out(["nvidia-smi", "--query-gpu=utilization.gpu,clocks.gr,power.draw,temperature.gpu,pstate,"
                "clocks_throttle_reasons.active", "--format=csv,noheader,nounits"], timeout=3)
    try:
        util, clock, power, temp, pstate, reasons = [x.strip() for x in text.strip().split(",")]
        return {"util": int(util), "clock": int(clock), "power": float(power), "temp": int(temp),
                "pstate": pstate, "reasons": int(reasons, 16)}
    except ValueError:
        return None


THROTTLE = {0x1: "простой", 0x2: "ограничение приложения", 0x4: "лимит мощности", 0x8: "перегрев (аппаратный)",
            0x20: "перегрев (программный)", 0x40: "лимит питания", 0x80: "перегрев (аппаратный)"}


def wifi_counters():
    iface = wifi_iface()
    text = out(["iw", "dev", iface, "station", "dump"]) if iface else ""
    c = {}
    for key, rx in (("retries", r"tx retries:\s+(\d+)"), ("failed", r"tx failed:\s+(\d+)"),
                    ("signal", r"signal:\s+(-?\d+)")):
        m = re.search(rx, text)
        c[key] = int(m.group(1)) if m else 0
    return c


def udp_rcvbuf_errors():
    try:
        with open("/proc/net/snmp") as f:
            lines = [l for l in f if l.startswith("Udp:")]
        head, vals = lines[0].split(), lines[1].split()
        return int(vals[head.index("RcvbufErrors")])
    except (OSError, ValueError, IndexError):
        return 0


def tcp_rtt(ip, port=443, timeout=1.0):
    s = socket.socket()
    s.settimeout(timeout)
    t0 = time.perf_counter()
    try:
        s.connect((ip, port))
        return (time.perf_counter() - t0) * 1000
    except OSError:
        return None
    finally:
        s.close()


def pct(values, q):
    v = sorted(values)
    return v[min(len(v) - 1, int(len(v) * q))] if v else None


def summarize(samples):
    def col(k):
        return [x[k] for x in samples if x.get(k) is not None]
    rtt, gw = col("rtt"), col("gw")
    res = {"seconds": len(samples), "mode": samples[-1]["mode"] if samples else None}
    if rtt:
        res["rtt_p50"], res["rtt_p95"], res["rtt_max"] = pct(rtt, .5), pct(rtt, .95), max(rtt)
        res["rtt_spikes"] = sum(1 for x in rtt if x > pct(rtt, .5) + 60)
    if gw:
        res["gw_p50"], res["gw_p95"], res["gw_max"] = pct(gw, .5), pct(gw, .95), max(gw)
    gw_all = [x.get("gw") for x in samples]
    res["gw_lost"] = sum(1 for x in gw_all if x is None)
    res["udp_drops"] = max(0, samples[-1]["drops"] - samples[0]["drops"]) if samples else 0
    res["rcvbuf_errors"] = max(0, samples[-1]["rcvbuf"] - samples[0]["rcvbuf"]) if samples else 0
    res["wifi_retries"] = max(0, samples[-1]["retries"] - samples[0]["retries"]) if samples else 0
    res["wifi_failed"] = max(0, samples[-1]["failed"] - samples[0]["failed"]) if samples else 0
    res["signal_min"] = min(col("signal")) if col("signal") else None
    res["thread_max_p95"] = pct(col("thread"), .95)
    gpu = [x["gpu"] for x in samples if x.get("gpu")]
    if gpu:
        res["gpu_util_p50"] = pct([g["util"] for g in gpu], .5)
        res["gpu_util_p95"] = pct([g["util"] for g in gpu], .95)
        res["gpu_clock_min"] = min(g["clock"] for g in gpu)
        res["gpu_temp_max"] = max(g["temp"] for g in gpu)
        reasons = 0
        for g in gpu:
            reasons |= g["reasons"] & ~0x1 & ~0x4000000000000000
        res["gpu_throttle"] = [name for bit, name in THROTTLE.items() if reasons & bit and bit != 0x1]
    return res


def verdict(r):
    """Plain-language findings ordered by how likely they explain lag."""
    notes = []
    if r.get("rtt_p50") is not None and r["rtt_p50"] > 150:
        notes.append("Далеко до серверов Roblox: медиана %.0f мс. Это маршрут провайдера, настройками не лечится." % r["rtt_p50"])
    if r.get("rtt_p95") is not None and r.get("rtt_p50") is not None and r["rtt_p95"] - r["rtt_p50"] > 50:
        notes.append("Задержка до Roblox скачет: p50 %.0f, p95 %.0f мс (%d выбросов). Рывки персонажа и лаги ввода." % (r["rtt_p50"], r["rtt_p95"], r.get("rtt_spikes", 0)))
    if r.get("gw_p95") is not None and r["gw_p95"] > 25:
        notes.append("Wi-Fi до роутера нестабилен: p95 %.0f мс, максимум %.0f. Это локальная проблема, не интернет." % (r["gw_p95"], r["gw_max"]))
    if r.get("gw_lost", 0) > 2:
        notes.append("До роутера потеряно %d из %d пингов: Wi-Fi теряет пакеты." % (r["gw_lost"], r["seconds"]))
    if r.get("wifi_failed", 0) > 0 or r.get("wifi_retries", 0) > r["seconds"] * 20:
        notes.append("Много повторных передач Wi-Fi (%d, из них неудачных %d): помехи или сигнал." % (r["wifi_retries"], r["wifi_failed"]))
    if r.get("udp_drops", 0) > 0 or r.get("rcvbuf_errors", 0) > 0:
        notes.append("Ядро отбросило UDP-пакеты игры (%d, переполнение буфера приёма): игра не успевала их читать." % max(r["udp_drops"], r["rcvbuf_errors"]))
    if r.get("gpu_throttle"):
        notes.append("Видеокарта сбрасывает частоту: %s (температура до %d°C, минимум %d МГц)." % (", ".join(sorted(set(r["gpu_throttle"]))), r.get("gpu_temp_max", 0), r.get("gpu_clock_min", 0)))
    if r.get("gpu_util_p95", 0) >= 97:
        notes.append("Видеокарта загружена на 97%+: FPS упирается в неё, а не в сеть. Нужно снижать графику.")
    if r.get("thread_max_p95", 0) >= 95:
        notes.append("Один поток игры занят на 95%+ ядра: упирается в процессор (главный поток Roblox).")
    if not notes:
        notes.append("Явных проблем с сетью, Wi-Fi, процессором и видеокартой в этой сессии не видно.")
    return notes


def cmd_game(args):
    cfg = config()
    deadline = time.monotonic() + args.seconds if args.seconds else None
    pids = game_pids(cfg)
    if not pids:
        print("игра не запущена, жду процесс %s…" % ", ".join(cfg["game_processes"]), file=sys.stderr)
        while not pids and (deadline is None or time.monotonic() < deadline):
            time.sleep(1)
            pids = game_pids(cfg)
        if not pids:
            return 1
    window = None
    try:
        for c in json.loads(out(["hyprctl", "clients", "-j"])):
            if c.get("pid") in pids or c.get("class", "").lower().find("sober") >= 0:
                window = {"class": c.get("class"), "title": c.get("title"), "fullscreen": c.get("fullscreen"),
                          "size": c.get("size")}
                break
    except ValueError:
        pass
    os.makedirs(STATE_DIR, exist_ok=True)
    path = "%s/game-%s.csv" % (STATE_DIR, time.strftime("%Y%m%d-%H%M%S"))
    gw_ip = default_gateway()
    samples, ticks, hz = [], {}, os.sysconf("SC_CLK_TCK")
    wifi = wifi_counters()
    base_drops = None
    web_ip, web_fail = None, 0
    n = 0
    pool = cf.ThreadPoolExecutor(2)
    print("запись сессии: %s (Ctrl-C — остановить и показать итог)" % path, file=sys.stderr)
    try:
        while (deadline is None or time.monotonic() < deadline):
            t0 = time.monotonic()
            pids = game_pids(cfg)
            if not pids:
                break
            f_gw = pool.submit(lambda: ping(gw_ip, 1, 0.2)) if gw_ip else None
            socks = udp_sockets(set(pids))
            peers = [p for p, _ in socks if p and not p.startswith(("127.", "[", "0.0.0.0", "*"))]
            if peers and web_ip is None:
                web_ip = peers[0].rsplit(":", 1)[0].rsplit(".", 1)[0] + ".3"
            f_rtt = pool.submit(tcp_rtt, web_ip or "128.116.5.3") if n % 2 == 0 else None
            cur = {}
            for pid in pids:
                for tid, tk in thread_ticks(pid).items():
                    cur[(pid, tid)] = tk
            busiest = 0.0
            for k, tk in cur.items():
                if k in ticks:
                    busiest = max(busiest, (tk - ticks[k]) / hz * 100)
            ticks = cur
            if n % 2 == 0:
                wifi = wifi_counters()
            gpu = gpu_sample() if n % 2 == 0 else (samples[-1].get("gpu") if samples else None)
            gwp = f_gw.result() if f_gw else None
            rtt = f_rtt.result() if f_rtt else None
            if rtt is None and f_rtt:
                web_fail += 1
                if web_fail >= 3:
                    web_ip, web_fail = "128.116.5.3", 0
            samples.append({"t": n, "mode": current_mode(), "gw": gwp["avg"] if gwp and "avg" in gwp else None,
                            "rtt": rtt, "drops": sum(d for _, d in socks), "rcvbuf": udp_rcvbuf_errors(),
                            "retries": wifi["retries"], "failed": wifi["failed"], "signal": wifi["signal"],
                            "thread": busiest, "gpu": gpu})
            n += 1
            time.sleep(max(0.0, 1.0 - (time.monotonic() - t0)))
    except KeyboardInterrupt:
        pass
    if len(samples) < 5:
        return 1
    with open(path, "w") as f:
        f.write("t,mode,gw_ms,rtt_ms,udp_drops,rcvbuf_errors,wifi_retries,wifi_failed,signal,busiest_thread_pct,gpu_util,gpu_clock,gpu_temp,gpu_reasons\n")
        for x in samples:
            g = x.get("gpu") or {}
            f.write("%d,%s,%s,%s,%d,%d,%d,%d,%d,%.0f,%s,%s,%s,%s\n" % (
                x["t"], x["mode"], "" if x["gw"] is None else "%.1f" % x["gw"], "" if x["rtt"] is None else "%.1f" % x["rtt"],
                x["drops"], x["rcvbuf"], x["retries"], x["failed"], x["signal"], x["thread"],
                g.get("util", ""), g.get("clock", ""), g.get("temp", ""), hex(g["reasons"]) if g else ""))
    result = summarize(samples)
    result["notes"] = verdict(result)
    result["when"] = int(time.time())
    result["window"] = window
    save_json(STATE_DIR + "/game-last.json", result)
    print_game(result)
    csvs = sorted(f for f in os.listdir(STATE_DIR) if f.startswith("game-") and f.endswith(".csv"))
    for f in csvs[:-8]:
        os.remove(os.path.join(STATE_DIR, f))
    return 0


def print_game(r):
    def ms(v):
        return "—" if v is None else "%.0f мс" % v
    print("сессия %d с, режим %s" % (r["seconds"], r["mode"]))
    print("до Roblox        p50 %s  p95 %s  макс %s  выбросов %s" % (ms(r.get("rtt_p50")), ms(r.get("rtt_p95")), ms(r.get("rtt_max")), r.get("rtt_spikes", "—")))
    print("до роутера       p50 %s  p95 %s  макс %s  потеряно %d" % (ms(r.get("gw_p50")), ms(r.get("gw_p95")), ms(r.get("gw_max")), r.get("gw_lost", 0)))
    print("Wi-Fi            повторов %d, неудач %d, сигнал мин %s дБм" % (r["wifi_retries"], r["wifi_failed"], r.get("signal_min")))
    print("UDP игры         сброшено ядром %d" % max(r["udp_drops"], r["rcvbuf_errors"]))
    if "gpu_util_p50" in r:
        print("видеокарта       загрузка p50 %d%% p95 %d%%, частота мин %d МГц, до %d°C" % (r["gpu_util_p50"], r["gpu_util_p95"], r["gpu_clock_min"], r["gpu_temp_max"]))
    print("главный поток    p95 %s%% ядра" % (("%.0f" % r["thread_max_p95"]) if r.get("thread_max_p95") is not None else "—"))
    print()
    for note in r["notes"]:
        print("• " + note)


# ---------------------------------------------------------------- auto mode

def video_window_open(cfg):
    try:
        clients = json.loads(out(["hyprctl", "clients", "-j"]))
    except ValueError:
        return False
    pats = [re.compile(p, re.I) for p in cfg["patterns"]]
    for c in clients:
        cls = (c.get("class") or "").lower()
        if any(b in cls for b in cfg["browsers"]) and any(p.search(c.get("title") or "") for p in pats):
            return True
    return False


def hypr_events():
    """Yield once per Hyprland event; fall back to a 3 s tick if there is no socket."""
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    rt = os.environ.get("XDG_RUNTIME_DIR")
    path = "%s/hypr/%s/.socket2.sock" % (rt, sig) if sig and rt else None
    while True:
        if path and os.path.exists(path):
            s = socket.socket(socket.AF_UNIX)
            try:
                s.connect(path)
                s.settimeout(3)
                buf = b""
                while True:
                    try:
                        data = s.recv(4096)
                        if not data:
                            break
                        buf += data
                        lines = buf.split(b"\n")
                        buf = lines.pop()
                        if any(l.split(b">>")[0] in (b"openwindow", b"closewindow", b"windowtitlev2", b"windowtitle")
                               for l in lines):
                            yield
                    except socket.timeout:
                        yield
            except OSError:
                pass
            finally:
                s.close()
        time.sleep(3)
        yield


def cmd_watch(_args):
    """Pick the profile from what is open: Sober gets Games, AnimeLib gets Video.

    The previous mode comes back when both are gone. A mode chosen by hand is
    left alone until the trigger goes away.
    """
    previous, owned, suppressed = None, None, False
    recorder = None
    last_check = 0.0
    for _ in hypr_events():
        if time.monotonic() - last_check < 1.0:
            continue
        last_check = time.monotonic()
        cfg = config()
        game = cfg["auto_game"] and game_running(cfg)
        video = cfg["auto_video"] and video_window_open(cfg)
        want = "gaming" if game else ("video" if video else None)
        now = current_mode()
        if want and owned is None and not suppressed and now != want:
            previous = now
            if set_mode(want) == 0:
                owned = want
        elif want and owned and now != owned:
            owned, suppressed = None, True            # a mode picked by hand: leave it alone
        elif want and owned and want != owned:
            if set_mode(want, quiet=True) == 0:
                owned = want
        elif not want:
            if owned and now == owned:
                set_mode(previous or "balanced")
            owned, suppressed = None, False
        if game and (recorder is None or recorder.poll() is not None):
            recorder = subprocess.Popen([sys.executable, os.path.abspath(__file__), "game"],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        elif not game and recorder is not None and recorder.poll() is not None:
            recorder = None


def cmd_auto(args):
    cfg = load_json(CONFIG_FILE, {})
    if args.state in ("on", "off"):
        cfg["auto_video"] = args.state == "on"
        save_json(CONFIG_FILE, cfg)
    print("on" if config()["auto_video"] else "off")
    return 0


# ---------------------------------------------------------------- commands

def cmd_status(args):
    snap = snapshot(deep=args.deep)
    snap["modes"] = modes()
    if args.json:
        print(json.dumps(snap, ensure_ascii=False))
        return 0
    names = {m["id"]: m["name"] for m in snap["modes"]}
    print("режим       %s" % names.get(snap["mode"], snap["mode"]))
    w = snap["wifi"]
    if w and w.get("connected"):
        print("wi-fi       %s  %g dBm  ↓%g ↑%g Мбит/с" % (w.get("ssid"), w.get("signal", 0), w.get("rx", 0), w.get("tx", 0)))
    print("роутер      %s" % fmt_ping(snap["gateway"]))
    print("интернет    %s" % fmt_ping(snap["internet"]))
    print("DNS         %s" % snap["dns"])
    print("TCP         %s" % snap["cc"])
    print("авто-видео  %s" % ("вкл" if snap["auto"] else "выкл"))
    print("ускоритель  %s" % ("работает, отдано %.0f МБ" % (snap["proxy"]["served"] / 1e6) if snap["proxy"] else "не запущен"))
    return 0


def cmd_pulse(_args):
    snap = snapshot()
    w = snap["wifi"] or {}
    print(json.dumps({
        "mode": snap["mode"],
        "rtt": (snap["internet"] or {}).get("avg"),
        "loss": (snap["internet"] or {}).get("loss"),
        "signal": w.get("signal"),
        "rate": w.get("rx"),
    }))
    return 0


def cmd_modes(args):
    ms = modes()
    if args.json:
        print(json.dumps(ms, ensure_ascii=False))
    else:
        cur = current_mode()
        for m in ms:
            print("%s %-9s %-9s %s" % ("●" if m["id"] == cur else " ", m["id"], m["name"], m["blurb"]))
    return 0


def cmd_bench(args):
    labels = {"dns": "DNS", "latency": "задержка", "down1": "1 поток", "down4": "4 потока"}
    r = bench(None if args.json else (lambda s: print("… " + labels[s], file=sys.stderr)))
    if args.json:
        print(json.dumps(r, ensure_ascii=False))
    else:
        print_bench(r)
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="netmode", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd")
    s = sub.add_parser("status")
    s.add_argument("--json", action="store_true")
    s.add_argument("--deep", action="store_true")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser("set")
    s.add_argument("mode")
    s.add_argument("-q", "--quiet", action="store_true")
    s.set_defaults(fn=lambda a: set_mode(a.mode, a.quiet))
    s = sub.add_parser("modes")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_modes)
    sub.add_parser("pulse").set_defaults(fn=cmd_pulse)
    s = sub.add_parser("bench")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_bench)
    s = sub.add_parser("get")
    s.add_argument("url")
    s.add_argument("-o", "--output")
    s.add_argument("-n", "--connections", type=int, default=16)
    s.set_defaults(fn=cmd_get)
    s = sub.add_parser("auto")
    s.add_argument("state", nargs="?", choices=["on", "off"])
    s.set_defaults(fn=cmd_auto)
    s = sub.add_parser("proxy")
    s.add_argument("--port", type=int)
    s.add_argument("-v", "--verbose", action="store_true")
    s.set_defaults(fn=cmd_proxy)
    s = sub.add_parser("keepalive")
    s.add_argument("--hz", type=float, default=100)
    s.set_defaults(fn=cmd_keepalive)
    sub.add_parser("token").set_defaults(fn=cmd_token)
    s = sub.add_parser("tune")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_tune)
    s = sub.add_parser("game")
    s.add_argument("--seconds", type=int, default=0)
    s.set_defaults(fn=cmd_game)
    sub.add_parser("watch").set_defaults(fn=cmd_watch)
    args = p.parse_args(argv)
    if not args.cmd:
        args = p.parse_args(["status"])
    try:
        return args.fn(args) or 0
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
